<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net472 = runtime réel du jeu (Mono / .NET 4.x), comme le plugin serveur. -->
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Coop.Client</AssemblyName>
    <RootNamespace>Coop.Client</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Les dépendances (LiteNetLib, Coop.Model) sont copiées à côté du plugin :
         BepInEx les charge depuis le dossier du plugin. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DebugType>none</DebugType>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <NoWarn>$(NoWarn);CS1701;CS1702</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Assembly-CSharp est nécessaire depuis que le client charge le monde :
         AutoLoadBehaviour manipule uGUI_MainMenu / SaveLoadManager / MainMenuLoadButton,
         et la garde de sauvegarde patche IngameMenu. -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SubnauticaManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Assembly-CSharp-firstpass porte `ModelPlug`, la base de `PlayerTool` : lire l'objet tenu du
         joueur local ne compile pas sans elle — et `UWE.PrefabDatabase` (le prefab du modèle tenu
         d'un joueur distant) en vient aussi. -->
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(SubnauticaManaged)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- HarmonyX fourni par BepInEx ; chargé par le preloader, jamais copié. -->
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SubnauticaManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SubnauticaManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Unity 2019.4 éclate UnityEngine en modules : ces types sont "forwardés" depuis
         UnityEngine.dll et ne se résolvent qu'avec le module qui les porte réellement.
         AnimationModule = Animator, PhysicsModule = Collider/Rigidbody,
         AudioModule = AudioListener, ScreenCaptureModule = ScreenCapture. -->
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(SubnauticaManaged)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(SubnauticaManaged)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(SubnauticaManaged)\UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule">
      <HintPath>$(SubnauticaManaged)\UnityEngine.ScreenCaptureModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- ImageConversionModule : Texture2D.EncodeToPNG, pour écrire les images de preuve. -->
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(SubnauticaManaged)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- uGUI : le panneau de connexion (Canvas, InputField, Button). `UnityEngine.UI.dll` porte aussi
         UnityEngine.EventSystems ; UIModule porte Canvas/CanvasRenderer, TextRenderingModule porte Font
         (le `Text` legacy des champs n'utilise pas TextMeshPro). -->
    <Reference Include="UnityEngine.UI">
      <HintPath>$(SubnauticaManaged)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(SubnauticaManaged)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(SubnauticaManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- InputLegacyModule : `Input.GetKeyDown` (valider l'adresse avec Entrée). -->
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(SubnauticaManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Coop.Model\Coop.Model.csproj" />
    <PackageReference Include="LiteNetLib" Version="1.3.5" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\BepInExModList.cs" Link="BepInExModList.cs" />
    <Compile Include="..\Shared\InstanceLogFile.cs" Link="InstanceLogFile.cs" />
    <Compile Include="..\Shared\AutoLoadBehaviour.cs" Link="AutoLoadBehaviour.cs" />
    <Compile Include="..\Shared\CreatureIdentity.cs" Link="CreatureIdentity.cs" />
    <Compile Include="..\Shared\VehicleIdentity.cs" Link="VehicleIdentity.cs" />
    <Compile Include="..\Shared\VehicleModules.cs" Link="VehicleModules.cs" />
    <Compile Include="..\Shared\ItemIdentity.cs" Link="ItemIdentity.cs" />
    <Compile Include="..\Shared\ViewDirection.cs" Link="ViewDirection.cs" />
    <Compile Include="..\Shared\SaveIdentitySource.cs" Link="SaveIdentitySource.cs" />
  </ItemGroup>

</Project>
