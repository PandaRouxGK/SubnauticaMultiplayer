<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net472 = runtime réel du jeu (Mono / .NET 4.x). Cible aussi celle des plugins BepInEx 5.
         Les assemblies de référence sont installées localement, donc aucun restore NuGet requis. -->
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Coop.Server</AssemblyName>
    <RootNamespace>Coop.Server</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Les dépendances NuGet (LiteNetLib) et le projet partagé doivent être copiés :
         BepInEx charge les plugins et leurs dépendances depuis le dossier du plugin. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DebugType>none</DebugType>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <!-- CS1701/CS1702 : simples avertissements de version sur les assemblies Unity du jeu. -->
    <NoWarn>$(NoWarn);CS1701;CS1702</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Code du jeu : donne accès à SaveLoadManager / uGUI_MainMenu / MainMenuLoadButton. -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SubnauticaManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Assembly-CSharp-firstpass porte les types de base du jeu (`ModelPlug`, dont dérive
         `PlayerTool`) ainsi que `UWE.PrefabDatabase` : sans cette référence, lire l'objet tenu de
         l'hôte ne compile pas, même si `PlayerTool` vient d'Assembly-CSharp. -->
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(SubnauticaManaged)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SubnauticaManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SubnauticaManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- AnimationModule : les paramètres `holding_*` de l'hôte sont **lus** sur son `Animator`
         (AnimatorControllerParameterType / GetBool) au lieu d'être dérivés, exactement comme le
         fait le client pour lui-même. Deux sources différentes pour la même donnée finiraient par
         diverger sans que rien ne le signale. -->
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(SubnauticaManaged)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- PhysicsModule : `Rigidbody` est *forwardé* depuis UnityEngine.dll et ne se résout pas sans lui.
         Nécessaire à la sonde de véhicule (M4), qui neutralise le Rigidbody avant de piloter le transform. -->
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(SubnauticaManaged)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Coop.Model\Coop.Model.csproj" />
    <!-- 1.3.5 : dernière branche 1.x, seule à fournir netstandard2.0 (2.x exige netstandard2.1,
         incompatible avec le net472 du jeu). -->
    <PackageReference Include="LiteNetLib" Version="1.3.5" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\BepInExModList.cs" Link="BepInExModList.cs" />
    <Compile Include="..\Shared\InstanceLogFile.cs" Link="InstanceLogFile.cs" />
    <Compile Include="..\Shared\AutoLoadBehaviour.cs" Link="AutoLoadBehaviour.cs" />
    <Compile Include="..\Shared\CreatureIdentity.cs" Link="CreatureIdentity.cs" />
    <Compile Include="..\Shared\VehicleIdentity.cs" Link="VehicleIdentity.cs" />
    <Compile Include="..\Shared\ViewDirection.cs" Link="ViewDirection.cs" />
  </ItemGroup>

</Project>
